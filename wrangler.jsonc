{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "foxy-gold-casino",
	"main": "src/index.ts",
	"compatibility_date": "2026-04-01",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"assets": {
		"directory": "./public/",
		"binding": "ASSETS",
		"run_worker_first": true
	},
	"observability": {
		"enabled": true
	},
	"preview_urls": true,
	"analytics_engine_datasets": [
		{
			"binding": "ANALYTICS",
			"dataset": "levr_aff_clicks"
		},
		{
			"binding": "PAGEVIEWS",
			"dataset": "levr_pageviews"
		}
	],
	"workers_dev": true
}
